# Engine settings (all optional; /memex sets token, key and treasury)
PORT=5023
RPC_URL=https://rpc.mainnet.chain.robinhood.com
# The cycle: escrow size (ETH) that triggers each step, in order feeding → keeper → sink → feeding …
FEEDING_ETH=0.01
KEEPER_ETH=0.02
SINK_ETH=0.01
# Feedings go to this many sitters, biggest balances first, split by balance
FEEDING_TOP_N=10
MIN_BALANCE=100000
# First $PADS must be this old (hours) to be fed; stops buying in right before a claim
MIN_HOLD_HOURS=0
CONTRACTS_ARE_SELLS=1
# extra sell destinations, comma separated (the curve and the Uniswap v4 PoolManager are already included)
SELL_SINKS=
# needed only to change token/key/treasury after they are set
ADMIN_SECRET=
# Connect X (optional). An X developer app, type "Web App", callback <SITE_URL>/api/x/callback.
# Leave empty and the "Connect X" button stays hidden.
SITE_URL=https://robinheist.fun
X_CLIENT_ID=
X_CLIENT_SECRET=
# 1 lets the demo edition try a real X sign-in (nothing saved). scripts/site-mode.sh sets it.
X_DEMO=0
