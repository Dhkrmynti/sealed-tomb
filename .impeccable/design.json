  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The one action: Buy on Pons.",
      "html": "<a class=\"ds-btn\">Buy on Pons</a>",
      "css": ".ds-btn{display:inline-flex;align-items:center;height:54px;padding:0 24px;border:2px solid var(--ochre-deep,#7f2412);background:var(--ochre,#a3311b);color:var(--ochre-ink,#f4efe6);font:800 16px/1 'Schibsted Grotesk',sans-serif;letter-spacing:.04em;text-transform:uppercase;box-shadow:10px 16px 28px -14px rgba(52,42,26,.5);transition:transform .18s cubic-bezier(.16,1,.3,1),background-color .18s}.ds-btn:hover{background:var(--ochre-deep,#7f2412);transform:translateY(-1px)}.ds-btn:active{transform:translateY(1px);box-shadow:none}.ds-btn:focus-visible{outline:3px solid var(--ochre,#a3311b);outline-offset:3px}"
    },
    {
      "name": "Waiting Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Before launch: Tomb opens soon.",
      "html": "<span class=\"ds-btn-wait\">Tomb opens soon</span>",
      "css": ".ds-btn-wait{display:inline-flex;align-items:center;height:54px;padding:0 24px;border:2px dashed currentColor;color:#1e1d1a;font:800 16px/1 'Schibsted Grotesk',sans-serif;letter-spacing:.04em;text-transform:uppercase;opacity:.8}"
    },
    {
      "name": "CA Tablet",
      "kind": "chip",
      "refersTo": "ca-tablet",
      "description": "The contract address; tap to copy.",
      "html": "<button class=\"ds-ca\"><span class=\"ds-ca-k\">CA</span><span class=\"ds-ca-v\">0x9d2f…0a2b</span></button>",
      "css": ".ds-ca{display:inline-flex;align-items:stretch;height:54px;padding:0;border:2px solid rgba(30,29,26,.4);background:transparent;color:#1e1d1a;cursor:pointer}.ds-ca:hover{border-color:#e4643f}.ds-ca-k{display:grid;place-items:center;padding:0 12px;background:#d4a62c;color:#1e1d1a;font:600 13px/1 'Red Hat Mono',monospace}.ds-ca-v{display:grid;align-items:center;padding:0 14px;font:400 14px/1 'Red Hat Mono',monospace}"
    },
    {
      "name": "Wallet Field",
      "kind": "input",
      "refersTo": "input-lookup",
      "description": "Find your block: paste a wallet.",
      "html": "<div class=\"ds-field\"><input class=\"ds-input\" placeholder=\"0x…\"><button class=\"ds-check\">Check</button></div>",
      "css": ".ds-field{display:flex;background:#201b16;padding:16px}.ds-input{flex:1;height:54px;padding:0 16px;border:2px solid #a3967f;border-right:0;background:#15120f;color:#e9deca;font:400 15px/1 'Red Hat Mono',monospace}.ds-input:focus-visible{outline:3px solid #e8a948}.ds-check{height:54px;padding:0 22px;border:2px solid #e9deca;background:#e9deca;color:#15120f;font:800 16px/1 'Schibsted Grotesk',sans-serif;text-transform:uppercase}.ds-check:hover{background:#e4643f;border-color:#e4643f}"
    },
    {
      "name": "Lintel",
      "kind": "nav",
      "refersTo": "lintel",
      "description": "The fixed soot beam with the ochre line.",
      "html": "<nav class=\"ds-lintel\"><b>The Sealed Tomb</b><a>The rite</a><a>The pyramid</a><a>Laws</a></nav>",
      "css": ".ds-lintel{display:flex;align-items:center;gap:24px;height:60px;padding:0 24px;background:#15120f;color:#e9deca;border-bottom:3px solid #a3311b}.ds-lintel b{font:400 17px/1 'Dela Gothic One',sans-serif;text-transform:uppercase}.ds-lintel a{color:#c4b8a3;font:600 14px/1 'Schibsted Grotesk',sans-serif}.ds-lintel a:hover{color:#e9deca;text-decoration:underline;text-decoration-color:#e4643f}"
    },
    {
      "name": "Capstone Stone",
      "kind": "card",
      "refersTo": "capstone-stone",
